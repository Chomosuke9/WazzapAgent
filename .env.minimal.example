# Minimal WazzapAgents configuration
# Copy this file to .env. Unlisted settings use safe local defaults.
# See .env.example for every available option.

# Required: API key for the default OpenAI-compatible responder.
LLM2_API_KEY=

# Recommended: your WhatsApp number, digits only with country code.
# This grants access to owner-only commands.
BOT_OWNER_JIDS=

# Recommended: a long private value used to sign in to the control panel.
CONTROL_PANEL_TOKEN=

# Optional: set the bot number to receive a pairing code in the console.
# Leave empty to pair with a QR code or from the control panel.
WA_PAIRING_NUMBER=

# Optional: uncomment these for a provider other than the OpenAI default.
# LLM2_ENDPOINT=https://openrouter.ai/api/v1
# LLM2_MODEL=openai/gpt-4.1
